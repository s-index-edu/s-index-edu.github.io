#!/usr/bin/env bash
# Reject commit messages that still claim Cursor co-authorship.
set -euo pipefail

MSG_FILE="${1:-}"
[[ -n "$MSG_FILE" && -f "$MSG_FILE" ]] || exit 0

if grep -Eiq '^[[:space:]]*Co-authored-by:[[:space:]]*Cursor[[:space:]]*<' "$MSG_FILE"; then
  echo "commit-msg: Co-authored-by: Cursor is not allowed in this repository." >&2
  exit 1
fi

exit 0
